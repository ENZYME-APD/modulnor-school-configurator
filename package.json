{
  "name": "bim-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && npm run build:api",
    "preview": "vite preview",
    "build:api": "esbuild server/handlers.ts --bundle --platform=node --target=node20 --format=esm --outfile=server/dist/handlers.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --log-level=warning"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "esbuild": "0.28.2",
    "eslint": "8.57.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.1.3",
    "prettier": "3.3.3",
    "typescript": "5.2.2",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@thatopen/components": "~3.6.0",
    "@thatopen/components-front": "~3.6.0",
    "@thatopen/fragments": "~3.6.0",
    "camera-controls": "^3.1.2",
    "three": "0.186.1",
    "web-ifc": "0.0.78",
    "xlsx": "^0.18.5"
  }
}
